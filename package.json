{
  "name": "aro-assurance-backend",
  "version": "1.0.0",
  "description": "API Backend pour ARO Assurance Madagascar - Déclarations digitales (PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=80000' nodemon src/server.js",
    "start": "NODE_OPTIONS='--max-http-header-size=80000' node src/server.js",
    "start:prod": "NODE_ENV=production NODE_OPTIONS='--max-http-header-size=80000' node src/server.js",
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "db:setup": "node scripts/setupDatabase.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:backup": "node scripts/backupDatabase.js",
    "cleanup": "node scripts/cleanup.js"
  },
  "keywords": [
    "insurance",
    "health",
    "api",
    "nodejs",
    "express",
    "postgresql",
    "render",
    "madagascar"
  ],
  "author": "ARO Assurance Madagascar",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
